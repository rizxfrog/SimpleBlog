scalar DateTime
scalar Long

type Query {
  me: User
  blogs(page: Int!, size: Int!, publishedOnly: Boolean): BlogPage!
  searchBlogs(query: String!, page: Int!, size: Int!): BlogSearchPage!
  blog(id: ID!): Blog
  hotBlogs(limit: Int): [Blog!]!
  categories: [Category!]!
  tags: [Tag!]!
  comments(blogId: ID!): [Comment!]!
  adminComments(blogId: ID, status: CommentStatus, keyword: String): [Comment!]!
}

type Mutation {
  login(input: LoginInput!): AuthPayload!
  register(input: RegisterInput!): AuthPayload!
  createBlog(input: BlogInput!): Blog!
  updateBlog(id: ID!, input: BlogInput!): Blog!
  deleteBlog(id: ID!): Boolean!
  recordBlogView(id: ID!): Boolean!
  voteBlog(id: ID!, value: Int!): Blog!
  createComment(input: CommentInput!): Comment!
  updateCommentStatus(id: ID!, status: CommentStatus!): Comment!
  voteComment(id: ID!, value: Int!): Comment!
  createReply(input: ReplyInput!): Comment!
  deleteComment(id: ID!): Boolean!
  batchUpdateCommentStatus(ids: [ID!]!, status: CommentStatus!): Boolean!
  createCategory(name: String!, slug: String!): Category!
  createTag(name: String!, slug: String!): Tag!
}

type AuthPayload {
  token: String!
  user: User!
}

input LoginInput {
  username: String!
  password: String!
}

input RegisterInput {
  username: String!
  password: String!
  displayName: String
  email: String
}

input BlogInput {
  title: String!
  summary: String
  content: String!
  categoryId: ID
  coverUrl: String
  published: Boolean
  tagIds: [ID!]
}

input CommentInput {
  blogId: ID!
  parentId: ID
  content: String!
  authorName: String
  authorEmail: String
  authorWebsite: String
}

enum CommentStatus {
  pending
  approved
  rejected
}

type BlogPage {
  items: [Blog!]!
  total: Long!
  page: Int!
  size: Int!
}

type BlogSearchPage {
  items: [Blog!]!
  total: Long!
  page: Int!
  size: Int!
  query: String!
}

type Blog {
  id: ID!
  title: String!
  summary: String
  content: String!
  authorId: ID!
  categoryId: ID
  coverUrl: String
  published: Boolean!
  views: Long!
  likes: Long!
  dislikes: Long!
  userVote: Int
  createdAt: DateTime!
  updatedAt: DateTime!
  rank: Float
  titleHighlight: String
  summaryHighlight: String
  author: User
  category: Category
  tags: [Tag!]!
}

type Category {
  id: ID!
  name: String!
  slug: String!
}

type Tag {
  id: ID!
  name: String!
  slug: String!
}

type Comment {
  id: ID!
  blogId: ID!
  userId: ID
  parentId: ID
  content: String!
  createdAt: DateTime!
  status: CommentStatus!
  upvotes: Long!
  downvotes: Long!
  authorName: String
  authorEmail: String
  authorWebsite: String
  user: User
  replies: [Comment!]!
}

input ReplyInput {
  commentId: ID!
  content: String!
  authorName: String
  authorEmail: String
  authorWebsite: String
}

type User {
  id: ID!
  username: String!
  displayName: String
  email: String
  avatarUrl: String
  status: String
  createdAt: DateTime
  updatedAt: DateTime
}
