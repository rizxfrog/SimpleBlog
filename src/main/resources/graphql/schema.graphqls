scalar DateTime
scalar Long

type Query {
  me: User
  blogs(page: Int!, size: Int!, publishedOnly: Boolean): BlogPage!
  searchBlogs(query: String!, page: Int!, size: Int!): BlogSearchPage!
  searchBlogsEs(query: String!, page: Int!, size: Int!): BlogSearchPage!
  blog(id: ID!): Blog
  hotBlogs(limit: Int): [Blog!]!
  categories: [Category!]!
  tags: [Tag!]!
  comments(blogId: ID!): [Comment!]!
  adminComments(blogId: ID, status: CommentStatus, keyword: String): [Comment!]!
  documents(includeHidden: Boolean = false, project: String = "default", version: String = "default"): [Document!]!
  documentTree(rootId: ID, includeHidden: Boolean = false, project: String = "default", version: String = "default"): [Document!]!
  document(id: ID!, includeHidden: Boolean = false, project: String = "default", version: String = "default"): Document
  searchDocuments(query: String!, page: Int!, size: Int!, includeHidden: Boolean = false, project: String = "default", version: String = "default"): DocumentSearchPage!
  documentProjects: [String!]!
  documentRevisions(documentId: ID!): [DocumentRevision!]!
  documentRevision(id: ID!): DocumentRevision
  documentVersions(project: String = "default"): [String!]!
}

type Mutation {
  login(input: LoginInput!): AuthPayload!
  register(input: RegisterInput!): AuthPayload!
  createBlog(input: BlogInput!): Blog!
  updateBlog(id: ID!, input: BlogInput!): Blog!
  deleteBlog(id: ID!): Boolean!
  recordBlogView(id: ID!): Boolean!
  voteBlog(id: ID!, value: Int!): Blog!
  createComment(input: CommentInput!): Comment!
  updateCommentStatus(id: ID!, status: CommentStatus!): Comment!
  voteComment(id: ID!, value: Int!): Comment!
  createReply(input: ReplyInput!): Comment!
  deleteComment(id: ID!): Boolean!
  batchUpdateCommentStatus(ids: [ID!]!, status: CommentStatus!): Boolean!
  createCategory(name: String!, slug: String!): Category!
  createTag(name: String!, slug: String!): Tag!
  createDocument(input: DocumentCreateInput!): Document!
  updateDocument(id: ID!, input: DocumentUpdateInput!): Document!
  moveDocument(id: ID!, input: DocumentMoveInput!): Document!
  toggleDocumentHidden(id: ID!, hidden: Boolean!): Document!
  deleteDocument(id: ID!): Boolean!
  restoreDocumentRevision(revisionId: ID!): Document!
  createDocumentVersion(project: String = "default", sourceVersion: String = "default", targetVersion: String!): Boolean!
  deleteDocumentVersion(project: String = "default", version: String!): Boolean!
  createDocumentProject(sourceProject: String = "default", targetProject: String!): Boolean!
  deleteDocumentProject(project: String!): Boolean!
}

type AuthPayload {
  token: String!
  user: User!
}

input LoginInput {
  username: String!
  password: String!
}

input RegisterInput {
  username: String!
  password: String!
  displayName: String
  email: String
}

input BlogInput {
  title: String!
  summary: String
  content: String!
  categoryId: ID
  coverUrl: String
  published: Boolean
  tagIds: [ID!]
}

input CommentInput {
  blogId: ID!
  parentId: ID
  content: String!
  authorName: String
  authorEmail: String
  authorWebsite: String
}

enum CommentStatus {
  pending
  approved
  rejected
}

enum DocumentNodeType {
  FOLDER
  DOC
}

input DocumentCreateInput {
  title: String!
  content: String
  parentId: ID
  sortOrder: Int
  hidden: Boolean
  slug: String
  project: String
  version: String
  type: DocumentNodeType
}

input DocumentUpdateInput {
  title: String
  content: String
  sortOrder: Int
  hidden: Boolean
  slug: String
  type: DocumentNodeType
}

input DocumentMoveInput {
  parentId: ID
  sortOrder: Int
  slug: String
}

type BlogPage {
  items: [Blog!]!
  total: Long!
  page: Int!
  size: Int!
}

type BlogSearchPage {
  items: [Blog!]!
  total: Long!
  page: Int!
  size: Int!
  query: String!
}

type DocumentSearchPage {
  items: [Document!]!
  total: Long!
  page: Int!
  size: Int!
  query: String!
}

type Blog {
  id: ID!
  title: String!
  summary: String
  content: String!
  authorId: ID!
  categoryId: ID
  coverUrl: String
  published: Boolean!
  views: Long!
  likes: Long!
  dislikes: Long!
  userVote: Int
  createdAt: DateTime!
  updatedAt: DateTime!
  rank: Float
  titleHighlight: String
  summaryHighlight: String
  author: User
  category: Category
  tags: [Tag!]!
}

type Category {
  id: ID!
  name: String!
  slug: String!
}

type Tag {
  id: ID!
  name: String!
  slug: String!
}

type Document {
  id: ID!
  title: String!
  content: String
  project: String!
  version: String!
  parentId: ID
  type: DocumentNodeType!
  path: String!
  sortOrder: Int!
  hidden: Boolean!
  createdAt: DateTime!
  updatedAt: DateTime!
  depth: Int!
  slug: String
  children: [Document!]!
}

type DocumentRevision {
  id: ID!
  documentId: ID!
  type: DocumentNodeType!
  title: String!
  content: String
  project: String!
  version: String!
  path: String!
  parentId: ID
  sortOrder: Int!
  hidden: Boolean!
  revisionNumber: Int!
  createdBy: ID
  createdAt: DateTime!
}

type Comment {
  id: ID!
  blogId: ID!
  userId: ID
  parentId: ID
  content: String!
  createdAt: DateTime!
  status: CommentStatus!
  upvotes: Long!
  downvotes: Long!
  authorName: String
  authorEmail: String
  authorWebsite: String
  user: User
  replies: [Comment!]!
}

input ReplyInput {
  commentId: ID!
  content: String!
  authorName: String
  authorEmail: String
  authorWebsite: String
}

type User {
  id: ID!
  username: String!
  displayName: String
  email: String
  avatarUrl: String
  status: String
  createdAt: DateTime
  updatedAt: DateTime
}
